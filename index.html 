<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>LCL 5.0 Registration</title>
<meta name="description" content="Team registration for Leo Cricket League 5.0">
<meta name="theme-color" content="#071a11">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Anton&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js" defer></script>
<style>
:root{
  --night:#06140d; --field:#0c2b1c; --turf:#1d5a36; --turf2:#236b40;
  --pitch:#c9a96e; --gold:#f2b632; --gold2:#ffd36b; --ball:#b3151d;
  --cream:#fbf7ee; --card:#fffdf8; --ink:#13261b; --muted:#5d6f63;
  --line:#e2dccd; --ok:#1f7a45; --bad:#c0262d; --radius:16px;
}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{
  margin:0; font-family:Manrope,system-ui,sans-serif; color:var(--ink);
  background-color:var(--night);
  background-image:
    radial-gradient(ellipse 60% 45% at 8% -5%, rgba(255,240,190,.28), transparent 60%),
    radial-gradient(ellipse 60% 45% at 92% -5%, rgba(255,240,190,.28), transparent 60%),
    linear-gradient(180deg, #06140d 0%, #0b2618 38%, #123e27 70%, #16492e 100%);
  background-attachment:fixed; min-height:100vh; -webkit-font-smoothing:antialiased;
}
/* mowed outfield stripes */
body::before{
  content:""; position:fixed; inset:auto 0 0 0; height:55vh; z-index:-1; pointer-events:none;
  background:repeating-linear-gradient(90deg, rgba(255,255,255,.035) 0 70px, transparent 70px 140px);
  -webkit-mask-image:linear-gradient(to top,#000 30%,transparent);
          mask-image:linear-gradient(to top,#000 30%,transparent);
}
a{color:inherit}
.wrap{max-width:980px; margin:0 auto; padding:0 16px}

/* ---------- HERO ---------- */
.hero{position:relative; padding:56px 0 40px; color:#fff; overflow:hidden}
.hero .floodlights{position:absolute; top:18px; left:0; right:0; display:flex; justify-content:space-between; padding:0 6%; opacity:.9; pointer-events:none}
.flood{width:54px; height:30px; border-radius:6px; background:
  radial-gradient(circle at 25% 35%, #fff9d9 0 5px, transparent 6px),
  radial-gradient(circle at 50% 35%, #fff9d9 0 5px, transparent 6px),
  radial-gradient(circle at 75% 35%, #fff9d9 0 5px, transparent 6px),
  radial-gradient(circle at 25% 75%, #fff9d9 0 5px, transparent 6px),
  radial-gradient(circle at 50% 75%, #fff9d9 0 5px, transparent 6px),
  radial-gradient(circle at 75% 75%, #fff9d9 0 5px, transparent 6px), #24332a;
  box-shadow:0 0 60px 18px rgba(255,244,200,.25)}
.hero-grid{display:grid; grid-template-columns:1.3fr .7fr; gap:24px; align-items:center; position:relative}
.kicker{display:inline-flex; gap:8px; align-items:center; font-weight:700; letter-spacing:.18em; text-transform:uppercase; font-size:12px; color:var(--gold2); background:rgba(242,182,50,.1); border:1px solid rgba(242,182,50,.35); padding:6px 12px; border-radius:99px}
.title{font-family:Anton,Impact,sans-serif; font-weight:400; line-height:.9; margin:18px 0 8px; font-size:clamp(64px,13vw,132px); letter-spacing:.01em}
.title .five{color:var(--gold); text-shadow:0 0 40px rgba(242,182,50,.35)}
.subtitle{font-size:clamp(17px,2.4vw,22px); font-weight:600; margin:0 0 6px; color:#e9f2ec}
.lead{color:#cfe0d5; margin:0 0 18px; max-width:540px; line-height:1.55; font-size:15.5px}
.lead p{margin:0 0 6px}
.lead .hey{font-family:Anton,Impact,sans-serif; font-size:26px; letter-spacing:.02em; color:var(--gold2); margin-bottom:4px}
.facts{display:grid; grid-template-columns:1fr 1fr; gap:8px; margin:0 0 16px; max-width:540px}
.facts div{background:rgba(255,255,255,.07); border:1px solid rgba(255,255,255,.14); border-radius:12px; padding:10px 12px; min-width:0}
.facts div:last-child{grid-column:1/-1}
.facts dt{font-size:11px; font-weight:800; letter-spacing:.12em; text-transform:uppercase; color:var(--gold2)}
.facts dd{margin:3px 0 0; font-weight:700; color:#fff; font-size:15px}
.contacts{max-width:540px; display:grid; gap:8px}
.contacts-h{margin:0; font-size:13px; color:#b9cfc1; font-weight:600}
.contact{display:flex; align-items:center; gap:8px; background:rgba(0,0,0,.25); border:1px solid rgba(255,255,255,.12); border-radius:12px; padding:9px 10px 9px 12px}
.contact > div{flex:1; min-width:0; font-size:14px; color:#eaf3ed}
.contact span{display:block; color:#b9cfc1; font-size:13px; font-variant-numeric:tabular-nums}
.cbtn{flex:none; text-decoration:none; font-weight:800; font-size:13px; padding:9px 12px; border-radius:9px; background:rgba(255,255,255,.12); color:#fff; min-height:40px; display:inline-flex; align-items:center}
.cbtn.wa{background:#1f7a45}
.chips{display:flex; flex-wrap:wrap; gap:8px}
.chip{font-size:13px; font-weight:600; padding:8px 12px; border-radius:10px; background:rgba(255,255,255,.07); border:1px solid rgba(255,255,255,.14); color:#eaf3ed}
.chip b{color:var(--gold2)}
.hero > *{position:relative; z-index:2}
#heroFx{position:absolute!important; inset:0; width:100%; height:100%; z-index:1!important; pointer-events:none}
.beams{position:absolute!important; inset:0; z-index:0!important; pointer-events:none; overflow:hidden}
.beams i{position:absolute; top:-10%; width:46%; height:140%; background:linear-gradient(180deg,rgba(255,244,200,.20),rgba(255,244,200,0) 70%); filter:blur(6px); transform-origin:top center}
.beams i:first-child{left:-2%; clip-path:polygon(18% 0,26% 0,100% 100%,0 100%); animation:sweepL 9s ease-in-out infinite alternate}
.beams i:last-child{right:-2%; clip-path:polygon(74% 0,82% 0,100% 100%,0 100%); animation:sweepR 11s ease-in-out infinite alternate}
@keyframes sweepL{from{transform:rotate(-4deg)}to{transform:rotate(6deg)}}
@keyframes sweepR{from{transform:rotate(4deg)}to{transform:rotate(-6deg)}}
.flood{animation:flick 6s infinite}
@keyframes flick{0%,100%{opacity:1}47%{opacity:1}48%{opacity:.55}50%{opacity:1}}
@keyframes spin{to{transform:rotate(360deg)}}
.crest{justify-self:center; position:relative; width:min(330px,72vw); aspect-ratio:1; display:grid; place-items:center}
.crest::before{content:""; position:absolute; inset:9%; border-radius:50%; background:radial-gradient(circle,rgba(242,182,50,.45),rgba(242,182,50,0) 68%); animation:halo 3.2s ease-in-out infinite}
@keyframes halo{0%,100%{transform:scale(.92); opacity:.7}50%{transform:scale(1.06); opacity:1}}
.crest-ring{position:absolute; inset:0; width:100%; height:100%; animation:spin 28s linear infinite}
.crest-ring text{font-family:Anton,Impact,sans-serif; font-size:17px; letter-spacing:3px; fill:var(--gold2)}
.crest-ring .seam{fill:none; stroke:rgba(255,211,107,.35); stroke-width:1.5; stroke-dasharray:2 7}
.crest img{position:relative; width:74%; height:auto; -webkit-mask-image:radial-gradient(closest-side,#000 70%,transparent 100%); mask-image:radial-gradient(closest-side,#000 70%,transparent 100%); animation:float 5s ease-in-out infinite; filter:drop-shadow(0 18px 30px rgba(0,0,0,.5))}
@keyframes float{0%,100%{transform:translateY(0)}50%{transform:translateY(-8px)}}
.stumps{position:absolute!important; left:max(16px,5%); bottom:0; width:64px; height:96px; z-index:2!important; pointer-events:none}
.stumps .bail{transform-box:fill-box; transform-origin:center}
.stumps.bowled .b1{animation:bailL .9s cubic-bezier(.2,.7,.3,1) forwards}
.stumps.bowled .b2{animation:bailR .9s cubic-bezier(.2,.7,.3,1) forwards}
.stumps.bowled .st{animation:wobble .5s ease-out}
@keyframes bailL{0%{transform:none}60%{transform:translate(-22px,-46px) rotate(-200deg); opacity:1}100%{transform:translate(-30px,-20px) rotate(-320deg); opacity:0}}
@keyframes bailR{0%{transform:none}60%{transform:translate(20px,-56px) rotate(240deg); opacity:1}100%{transform:translate(28px,-24px) rotate(380deg); opacity:0}}
@keyframes wobble{0%{transform:rotate(0)}30%{transform:rotate(-6deg)}60%{transform:rotate(3deg)}100%{transform:rotate(0)}}
.stumps .st{transform-box:fill-box; transform-origin:bottom center}
.ticker{background:linear-gradient(90deg,var(--gold),var(--gold2),var(--gold)); color:#2b1d00; overflow:hidden; white-space:nowrap; border-block:2px solid #2b1d00; position:relative; z-index:3}
.ticker-track{display:inline-flex; animation:tick 32s linear infinite; padding-block:9px}
.ticker-track span{font-family:Anton,Impact,sans-serif; font-size:16px; letter-spacing:.12em; padding-inline:18px}
.ticker-track span::after{content:"●"; color:var(--ball); margin-left:36px; font-size:12px; vertical-align:2px}
@keyframes tick{to{transform:translateX(-50%)}}
.hero-copy > *{animation:rise .7s cubic-bezier(.2,.7,.3,1) both}
.hero-copy > *:nth-child(2){animation-delay:.08s}.hero-copy > *:nth-child(3){animation-delay:.16s}.hero-copy > *:nth-child(4){animation-delay:.24s}.hero-copy > *:nth-child(5){animation-delay:.32s}
@keyframes rise{from{transform:translateY(14px)}to{transform:none}}
@media (prefers-reduced-motion:reduce){.crest-ring,.crest img,.crest::before,.beams i,.flood,.ticker-track,.hero-copy > *,.btn::after,.bar-ball{animation:none!important}}
.status-banner{margin-top:22px; display:none; padding:12px 14px; border-radius:12px; font-weight:600; font-size:14px}
.status-banner.show{display:block}
.status-banner.open{background:rgba(31,122,69,.25); border:1px solid rgba(110,220,150,.4); color:#c8f5d8}
.status-banner.closed{background:rgba(192,38,45,.22); border:1px solid rgba(255,120,120,.45); color:#ffd7d7}

/* ---------- PROGRESS ---------- */
.progress{position:sticky; top:0; z-index:20; background:rgba(6,20,13,.86); backdrop-filter:blur(10px); -webkit-backdrop-filter:blur(10px); border-bottom:1px solid rgba(255,255,255,.08)}
.progress .wrap{display:flex; align-items:center; gap:14px; padding-top:10px; padding-bottom:10px; color:#d7e6dc; font-size:13px; font-weight:600}
.bar{flex:1; height:8px; border-radius:99px; background:rgba(255,255,255,.1); position:relative}
.bar-ball{position:absolute; top:50%; left:0; width:16px; height:16px; margin:-8px 0 0 -8px; border-radius:50%; background:radial-gradient(circle at 35% 30%,#ef5a62,#b3151d 55%,#5e0a0f); box-shadow:0 0 0 2px rgba(0,0,0,.25),0 0 12px rgba(242,182,50,.5); transition:left .35s}
.bar-ball::after{content:""; position:absolute; inset:2px 6px; border-left:1.5px solid #f3e6c9; border-right:1.5px solid #f3e6c9; border-radius:40%}
.bar i{display:block; height:100%; width:0; background:linear-gradient(90deg,var(--gold),var(--gold2)); border-radius:99px; transition:width .35s}
.steps{display:flex; gap:6px}
.steps a{text-decoration:none; padding:4px 9px; border-radius:8px; background:rgba(255,255,255,.06); white-space:nowrap}
.steps a.done{background:rgba(242,182,50,.2); color:var(--gold2)}
@media (max-width:720px){.steps{display:none}}

/* ---------- CARDS ---------- */
main{padding:22px 0 130px}
main.wrap,#success.wrap{max-width:720px}
.card{background:var(--card); border-radius:var(--radius); padding:26px; margin-bottom:22px; box-shadow:0 18px 50px rgba(0,0,0,.35); border-top:6px solid var(--gold); scroll-margin-top:64px; position:relative}
.card-head{display:flex; align-items:center; gap:14px; margin-bottom:18px}
.badge{flex:none; width:44px; height:44px; border-radius:12px; display:grid; place-items:center; font-family:Anton,sans-serif; font-size:22px; color:#fff; background:linear-gradient(145deg,var(--turf2),var(--field))}
.card h2{margin:0; font-size:21px; font-weight:800; letter-spacing:-.01em}
.card .hint{margin:2px 0 0; color:var(--muted); font-size:14px}
.grid{display:grid; gap:14px}
.g2{grid-template-columns:1fr 1fr}
.g3{grid-template-columns:repeat(3,1fr)}
@media (max-width:720px){.g2,.g3{grid-template-columns:1fr}.hero-grid{grid-template-columns:1fr; gap:6px}.crest{order:-1; width:min(200px,56vw)}.hero{padding:34px 0 84px}.title{margin-top:8px; font-size:clamp(60px,20vw,96px)}.card{padding:20px 16px}.card-head{margin-bottom:14px}.stumps{width:44px; height:66px}.hero .floodlights{top:10px}.flood{width:40px; height:22px}}
.f{display:flex; flex-direction:column; gap:6px; min-width:0}
.f > span{font-size:13px; font-weight:700; color:#34493c}
.f > span em{color:var(--bad); font-style:normal}
input,select{font:inherit; font-size:16px; color:var(--ink); width:100%; min-height:48px; padding:12px 13px; border-radius:11px; border:1.5px solid var(--line); background:#fff; outline:none; transition:border-color .15s, box-shadow .15s; min-width:0}
input:focus,select:focus{border-color:var(--turf2); box-shadow:0 0 0 4px rgba(35,107,64,.15)}
input.err,select.err{border-color:var(--bad); box-shadow:0 0 0 4px rgba(192,38,45,.12); background:#fff7f7}
.msg{display:none; margin-top:12px; padding:11px 13px; border-radius:10px; background:#fdeceb; color:#8f1c21; font-size:14px; font-weight:600}
.msg.show{display:block}

/* ---------- PLAYERS ---------- */
.squad-meta{display:flex; flex-wrap:wrap; gap:8px; justify-content:space-between; align-items:center; margin-bottom:12px}
.count-pill{font-size:13px; font-weight:700; padding:6px 10px; border-radius:99px; background:#eef4ef; color:var(--turf)}
.count-pill.full{background:var(--turf); color:#fff}
.link-btn{font:inherit; font-size:13px; font-weight:700; color:var(--turf); background:none; border:1.5px dashed #b7cbbd; padding:7px 11px; border-radius:9px; cursor:pointer}
.link-btn:hover{background:#f2f7f3}
.group-label{display:flex; align-items:center; gap:10px; margin:18px 0 8px; font-size:12px; font-weight:800; letter-spacing:.14em; text-transform:uppercase; color:var(--muted)}
.group-label::after{content:""; flex:1; height:1px; background:var(--line)}
.prow{display:grid; grid-template-columns:1fr 1fr; gap:10px; align-items:end; background:#faf7ef; border:1px solid var(--line); border-radius:14px; padding:12px; margin-bottom:10px}
.prow .pidx,.prow .fname,.prow .fclub{grid-column:1/-1}
.phead{display:none!important}
.subs .prow{grid-template-columns:1fr 1fr 1fr}
.phead{font-size:12px; font-weight:800; color:var(--muted); text-transform:uppercase; letter-spacing:.06em; padding:0 2px 6px}
.pidx{display:flex; align-items:center; gap:6px}
.pnum{width:26px; height:26px; display:grid; place-items:center; font-weight:800; font-size:13px; border-radius:50%; background:#f0ece1}
.gtag{font-size:11px; font-weight:800; padding:3px 6px; border-radius:6px}
.gtag.boy{background:#e5eefb; color:#24508f}
.gtag.girl{background:#fbe6ef; color:#9a2659}
.prow .cap{display:none; font-size:10px; font-weight:800; background:var(--gold); color:#3a2900; border-radius:5px; padding:2px 6px; margin-left:auto}
.prow.is-cap .cap{display:inline}
.pslot{font-size:12px; font-weight:800; letter-spacing:.08em; text-transform:uppercase; color:var(--muted); margin-left:4px}
@media (min-width:640px){ .prow{grid-template-columns:1.6fr 1fr 1fr} .prow .fname{grid-column:auto} .subs .prow{grid-template-columns:1.6fr 1fr 1fr 1fr} .subs .prow .fname{grid-column:auto} }
@media (max-width:400px){ .subs .prow{grid-template-columns:1fr 1fr} .subs .prow .fname{grid-column:1/-1} }
.example{font-size:13px; color:var(--muted); margin-top:10px}
.example code{background:#f0ece1; padding:2px 6px; border-radius:6px; font-family:inherit; font-weight:700; color:var(--ink)}

/* ---------- PAYMENT ---------- */
.pay{display:grid; grid-template-columns:260px 1fr; gap:24px; align-items:start}
@media (max-width:720px){.pay{grid-template-columns:1fr}}
.qr-box{max-width:300px; width:100%; justify-self:center; border:2px solid var(--line); border-radius:16px; padding:16px; text-align:center}
.qr-box #qr{display:grid; place-items:center; min-height:220px; position:relative}
.qr-logo{position:absolute; left:50%; top:50%; width:22%; transform:translate(-50%,-50%); border-radius:10px; border:3px solid #fff; background:#fff; box-shadow:0 2px 8px rgba(0,0,0,.2)}
.payee{font-size:13px; color:var(--muted); margin:-6px 0 14px}
.payee b{color:var(--ink)}
.qr-box #qr img,.qr-box #qr canvas{max-width:100%; height:auto}
.qr-box .amt{font-family:Anton,sans-serif; font-size:30px; margin-top:10px; color:var(--field)}
.qr-box .amt small{font-family:Manrope; font-size:13px; color:var(--muted); display:block; font-weight:600}
.upi-line{display:flex; gap:8px; align-items:center; background:#f4f1e8; border-radius:11px; padding:10px 12px; margin-bottom:14px}
.upi-line code{flex:1; font-family:inherit; font-weight:800; font-size:16px; word-break:break-all}
.btn-sm{font:inherit; font-size:13px; font-weight:800; min-height:40px; padding:8px 14px; border-radius:9px; border:0; background:var(--field); color:#fff; cursor:pointer}
.qr-save{margin-top:12px; min-height:44px; width:100%}
.btn-pay{display:none; text-align:center; text-decoration:none; font-weight:800; padding:13px; border-radius:11px; border:1.5px solid var(--turf); color:var(--turf); margin-bottom:14px; min-height:48px}
@media (pointer:coarse){.btn-pay{display:block}}
.pay ol{margin:0 0 16px; padding-left:20px; color:#34493c; line-height:1.7; font-size:15px}
.file{position:relative}
.file input{padding:10px}
.preview{margin-top:8px; max-height:140px; border-radius:10px; display:none; border:1px solid var(--line)}
.confirm{display:flex; gap:10px; align-items:flex-start; margin-top:16px; font-size:14px; font-weight:600; color:#34493c; cursor:pointer}
.confirm{padding:12px; background:#f4f1e8; border-radius:12px}
.confirm input{min-height:0; width:24px; height:24px; flex:none; margin-top:1px; accent-color:var(--turf)}

/* ---------- SUBMIT ---------- */
.submit-bar{position:fixed; left:0; right:0; bottom:0; z-index:30; background:rgba(6,20,13,.92); backdrop-filter:blur(10px); -webkit-backdrop-filter:blur(10px); border-top:1px solid rgba(255,255,255,.1); padding:12px 0 calc(12px + env(safe-area-inset-bottom))}
.submit-bar .wrap{display:flex; gap:12px; align-items:center; justify-content:space-between}
.submit-bar .note{color:#b9cfc1; font-size:13px}
.btn{font:inherit; font-weight:800; font-size:16px; letter-spacing:.02em; padding:14px 26px; border-radius:12px; border:0; cursor:pointer; color:#2b1d00; background:linear-gradient(180deg,var(--gold2),var(--gold)); box-shadow:0 8px 24px rgba(242,182,50,.3); display:inline-flex; gap:10px; align-items:center; white-space:nowrap}
.btn{position:relative; overflow:hidden}
.btn::after{content:""; position:absolute; top:0; bottom:0; width:40%; left:-60%; background:linear-gradient(100deg,transparent,rgba(255,255,255,.55),transparent); animation:shine 3.4s ease-in-out infinite}
@keyframes shine{0%,55%{left:-60%}100%{left:130%}}
.btn:disabled{opacity:.65; cursor:not-allowed}
.btn:focus-visible,.btn-sm:focus-visible,.link-btn:focus-visible,.btn-ghost:focus-visible{outline:3px solid var(--gold2); outline-offset:2px}
.spinner{width:18px; height:18px; border-radius:50%; border:3px solid rgba(43,29,0,.25); border-top-color:#2b1d00; animation:spin .8s linear infinite; display:none}
.btn.loading .spinner{display:inline-block}
@media (max-width:560px){.submit-bar .note{display:none}.btn{width:100%; justify-content:center}}

/* ---------- SUCCESS ---------- */
#success{display:none; padding:40px 0 80px}
#confetti{position:fixed; inset:0; width:100%; height:100%; pointer-events:none; z-index:60}
.stamp{position:absolute; right:22px; top:22px; font-family:Anton,Impact,sans-serif; font-size:30px; letter-spacing:.06em; color:var(--gold2); border:3px solid var(--gold2); border-radius:12px; padding:4px 12px; transform:rotate(-10deg); animation:stamp .6s cubic-bezier(.2,1.6,.4,1) .2s both}
@keyframes stamp{from{transform:rotate(-10deg) scale(2.4); opacity:0}to{transform:rotate(-10deg) scale(1); opacity:1}}
@media (max-width:560px){.stamp{font-size:22px; right:16px; top:auto; bottom:18px}.ticket-top{padding-bottom:64px}}
.foot-crest{width:56px; height:auto; display:block; margin:0 auto 8px; -webkit-mask-image:radial-gradient(closest-side,#000 70%,transparent 100%); mask-image:radial-gradient(closest-side,#000 70%,transparent 100%)}
.ticket{background:var(--card); border-radius:20px; overflow:hidden; box-shadow:0 24px 60px rgba(0,0,0,.4)}
.ticket-top{background:linear-gradient(135deg,var(--field),var(--turf)); color:#fff; padding:28px; position:relative}
.ticket-top h2{font-family:Anton,sans-serif; font-weight:400; font-size:40px; margin:6px 0 0; letter-spacing:.01em}
.regid{display:inline-block; margin-top:14px; font-family:Anton,sans-serif; font-size:30px; color:var(--gold2); letter-spacing:.06em; background:rgba(0,0,0,.25); padding:6px 14px; border-radius:10px}
.ticket-body{padding:24px 28px 28px}
.ticket-body table{width:100%; border-collapse:collapse; font-size:14px}
.ticket-body td{padding:8px 6px; border-bottom:1px dashed var(--line); vertical-align:top}
.ticket-body td:first-child{color:var(--muted); font-weight:700; width:38%}
.ticket-actions{display:flex; gap:10px; flex-wrap:wrap; margin-top:20px}
.btn-ghost{font:inherit; font-weight:800; font-size:14px; padding:11px 16px; border-radius:10px; border:1.5px solid var(--line); background:#fff; cursor:pointer}
footer{color:#9fb8a8; font-size:13px; text-align:center; padding:10px 0 30px}
footer b{color:#dfeee4}
.toast{position:fixed; left:50%; bottom:90px; transform:translateX(-50%) translateY(20px); background:#111; color:#fff; padding:10px 16px; border-radius:10px; font-size:14px; font-weight:600; opacity:0; transition:.25s; z-index:50; pointer-events:none}
.toast.show{opacity:1; transform:translateX(-50%) translateY(0)}
@media print{
  body{background:#fff}.hero,.progress,main,.submit-bar,footer,.ticket-actions{display:none!important}
  #success{display:block!important; padding:0}.ticket{box-shadow:none; border:1px solid #ccc}
}
</style>
</head>
<body>

<header class="hero">
  <div class="beams" aria-hidden="true"><i></i><i></i></div>
  <canvas id="heroFx" aria-hidden="true"></canvas>
  <div class="floodlights" aria-hidden="true"><div class="flood"></div><div class="flood"></div></div>
  <div class="wrap hero-grid">
    <div class="hero-copy">
      <span class="kicker">🏏 Leo Club of Mumbai Western presents</span>
      <h1 class="title">LCL <span class="five">5.0</span></h1>
      <p class="subtitle">Leo Cricket League · Season 5 · Team Registration</p>
      <div class="lead">
        <p class="hey">Hey Leos!!</p>
        <p>Please fill out the below form for the registration of your team for the Leo Cricket League 5.0 !!</p>
        <p>Do not miss out on any detail, to avoid any confusions later.</p>
      </div>
      <dl class="facts">
        <div><dt>Date</dt><dd id="factDate"></dd></div>
        <div><dt>Venue</dt><dd id="factVenue"></dd></div>
        <div><dt>Registration fee</dt><dd>₹5,000 per team</dd></div>
        <div><dt>Team owner</dt><dd>₹5,000 per team</dd></div>
        <div><dt>Squad</dt><dd>7 boys + 2 girls, up to 2 subs</dd></div>
      </dl>
      <div class="contacts" id="contacts"></div>
      <div class="status-banner" id="statusBanner"></div>
    </div>
    <div class="crest" aria-hidden="true">
      <svg class="crest-ring" viewBox="0 0 300 300">
        <defs><path id="ringPath" d="M150,150 m-128,0 a128,128 0 1,1 256,0 a128,128 0 1,1 -256,0"/></defs>
        <circle class="seam" cx="150" cy="150" r="143"/><circle class="seam" cx="150" cy="150" r="112"/>
        <text><textPath href="#ringPath" textLength="796">LEO CRICKET LEAGUE • SEASON 5 • LCL 5.0 • GOING ONE STEP BEYOND •</textPath></text>
      </svg>
      <img src="data:image/jpeg;base64," alt="Leo Club of Mumbai Western crest" width="560" height="511">
    </div>
  </div>
  <svg class="stumps" id="stumps" viewBox="0 0 64 96" aria-hidden="true">
    <g fill="#f3e6c9" stroke="#8a6a3a" stroke-width="1">
      <rect class="st" x="8" y="14" width="7" height="82" rx="3"/><rect class="st" x="28.5" y="14" width="7" height="82" rx="3"/><rect class="st" x="49" y="14" width="7" height="82" rx="3"/>
      <rect class="bail b1" x="9" y="8" width="25" height="5" rx="2.5" fill="#f2b632"/><rect class="bail b2" x="30" y="8" width="25" height="5" rx="2.5" fill="#f2b632"/>
    </g>
  </svg>
</header>
<div class="ticker" aria-hidden="true"><div class="ticker-track" id="tickerTrack"></div></div>

<nav class="progress" aria-label="Form progress">
  <div class="wrap">
    <div class="steps">
      <a href="#s-team" data-step="team">1 Team</a>
      <a href="#s-squad" data-step="squad">2 Squad</a>
      <a href="#s-captain" data-step="captain">3 Captain</a>
      <a href="#s-pay" data-step="pay">4 Payment</a>
    </div>
    <div class="bar"><i id="barFill"></i><b class="bar-ball" id="barBall"></b></div>
    <span id="barText">0%</span>
  </div>
</nav>

<main class="wrap" id="formWrap">
<form id="regForm" novalidate autocomplete="on">

  <!-- 1. TEAM -->
  <section class="card" id="s-team">
    <div class="card-head"><div class="badge">1</div><div><h2>Team details</h2><p class="hint">Your franchise, its owner and the club it represents.</p></div></div>
    <div class="grid g3">
      <label class="f"><span>Team name <em>*</em></span><input id="teamName" maxlength="60" placeholder="e.g. Western Warriors" required></label>
      <label class="f"><span>Team owner name <em>*</em></span><input id="ownerName" maxlength="60" placeholder="Full name" autocomplete="name" required></label>
      <label class="f"><span>Club name <em>*</em></span><input id="clubName" maxlength="80" list="clubList" placeholder="e.g. Leo Club of Mumbai Western" required></label>
    </div>
    <div class="msg" id="m-team"></div>
  </section>

  <!-- 2. SQUAD -->
  <section class="card" id="s-squad">
    <div class="card-head"><div class="badge">2</div><div><h2>Squad</h2><p class="hint">9 players are compulsory: 7 boys and 2 girls. Substitutes are optional.</p></div></div>
    <div class="squad-meta">
      <span class="count-pill" id="squadCount">0 / 9 players</span>
      <button type="button" class="link-btn" id="fillClub">Use team club for all players</button>
    </div>

    <div class="phead"><span>#</span><span>Player name</span><span>Jersey size</span><span>Jersey no.</span><span>Club</span></div>
    <div class="group-label">Boys · 7 compulsory</div>
    <div id="boys"></div>
    <div class="group-label">Girls · 2 compulsory</div>
    <div id="girls"></div>

    <div class="subs">
      <div class="group-label">Substitutes · optional (max 2)</div>
      <div class="phead"><span>#</span><span>Player name</span><span>Gender</span><span>Size</span><span>Jersey no.</span><span>Club</span></div>
      <div id="subs"></div>
    </div>
    <p class="example">Each player is recorded as <code>Arham Jain, M, 10</code> (name, jersey size, jersey number). Jersey numbers must be unique within your team.</p>
    <div class="msg" id="m-squad"></div>
  </section>

  <!-- 3. CAPTAIN -->
  <section class="card" id="s-captain">
    <div class="card-head"><div class="badge">3</div><div><h2>Captain</h2><p class="hint">Pick the captain from your squad. We'll use these contacts for all match updates.</p></div></div>
    <div class="grid g2">
      <label class="f"><span>Who is the captain? <em>*</em></span>
        <select id="captainSlot" required><option value="">Select a player from the squad</option></select>
      </label>
      <label class="f"><span>Captain's name</span><input id="captainName" readonly placeholder="Auto-filled from squad" tabindex="-1" style="background:#f6f3ea"></label>
      <label class="f"><span>Captain's mobile (WhatsApp) <em>*</em></span><input id="captainPhone" type="tel" inputmode="numeric" maxlength="14" placeholder="10-digit mobile number" autocomplete="tel" required></label>
      <label class="f"><span>Captain's email <em>*</em></span><input id="captainEmail" type="email" maxlength="100" placeholder="name@example.com" autocomplete="email" required></label>
      <label class="f"><span>Alternate contact number</span><input id="altPhone" type="tel" inputmode="numeric" maxlength="14" placeholder="Optional"></label>
    </div>
    <div class="msg" id="m-captain"></div>
  </section>

  <!-- 4. PAYMENT -->
  <section class="card" id="s-pay">
    <div class="card-head"><div class="badge">4</div><div><h2>Entry fee payment</h2><p class="hint">Scan the QR or pay to the UPI ID, then enter the transaction details below.</p></div></div>
    <div class="pay">
      <div class="qr-box">
        <div id="qr" aria-label="UPI payment QR code"></div>
        <div class="amt" id="amtText"></div>
        <button type="button" class="btn-sm qr-save" id="saveQr">Save QR to gallery</button>
      </div>
      <div>
        <div class="upi-line"><code id="upiId"></code><button type="button" class="btn-sm" id="copyUpi">Copy</button></div>
        <p class="payee">Paying to <b id="payeeName"></b>. Check this name in your UPI app before paying.</p>
        <a class="btn-pay upi-app" id="upiApp" href="#">Open UPI app to pay</a>
        <ol>
          <li><b>On this phone:</b> tap <b>Copy</b> and pay to the UPI ID in GPay, PhonePe or Paytm, or tap <b>Save QR to gallery</b> and scan it from your gallery inside the app.</li>
          <li><b>From another phone:</b> just scan the QR.</li>
          <li>Pay <b>₹5,000 registration + ₹5,000 team owner</b> and add your <b>team name</b> in the payment note.</li>
          <li>Enter the UTR / transaction ID from the receipt below and upload the screenshot.</li>
        </ol>
        <div class="grid g2">
          <label class="f"><span>Paid by (name on UPI) <em>*</em></span><input id="payerName" maxlength="60" placeholder="Name of person who paid" required></label>
          <label class="f"><span>UPI transaction ID / UTR <em>*</em></span><input id="utr" maxlength="35" placeholder="e.g. 4321 8765 1234" autocomplete="off" required></label>
        </div>
        <label class="f file" style="margin-top:14px"><span>Payment screenshot <em id="ssReq">*</em></span>
          <input id="screenshot" type="file" accept="image/*">
          <img class="preview" id="ssPreview" alt="Screenshot preview">
        </label>
      </div>
    </div>
    <label class="confirm"><input type="checkbox" id="confirmBox"> I confirm the squad details are correct, the entry fee has been paid, and our team agrees to follow the LCL 5.0 rules and the organisers' decisions.</label>
    <div class="msg" id="m-pay"></div>
  </section>
</form>
</main>

<section id="success" class="wrap" aria-live="polite">
  <div class="ticket">
    <div class="ticket-top">
      <span class="kicker">✅ Registration received</span>
      <div class="stamp" aria-hidden="true">HOWZAT!</div>
      <h2 id="sTeam">Team</h2>
      <div class="regid" id="sId">LCL5-000</div>
      <p style="margin:12px 0 0;color:#cfe3d6;font-size:14px">Save this Registration ID. Your payment will be verified by the organising team and the captain will be contacted on WhatsApp.</p>
    </div>
    <div class="ticket-body">
      <table id="sTable"></table>
      <div class="ticket-actions">
        <button class="btn-ghost" type="button" onclick="window.print()">Print / save as PDF</button>
        <button class="btn-ghost" type="button" id="another">Register another team</button>
      </div>
    </div>
  </div>
</section>

<footer class="wrap" id="footer"></footer>

<div class="submit-bar" id="submitBar">
  <div class="wrap">
    <span class="note" id="saveNote">Your progress is saved on this device automatically.</span>
    <button class="btn" id="submitBtn" type="button"><span class="spinner"></span><span id="btnText">Submit registration</span></button>
  </div>
</div>
<div class="toast" id="toast"></div>
<canvas id="confetti" aria-hidden="true"></canvas>

<datalist id="clubList"></datalist>

<script>
/* =====================================================================
   EDIT THESE SETTINGS BEFORE GOING LIVE
   ===================================================================== */
const CONFIG = {
  // Paste the Web App URL from Google Apps Script (ends with /exec)
  SCRIPT_URL: "PASTE_YOUR_APPS_SCRIPT_WEB_APP_URL_HERE",

  UPI_ID: "shubham.rajeevagarwal-3@okhdfcbank", // UPI ID that receives the fee
  UPI_PAYEE_NAME: "Shubham Agarwal",           // name shown in the payer's UPI app
  UPI_AID: "uGICAgMDA_vz1eA",                // from the original GPay QR (leave as is)
  ENTRY_FEE: 0,                              // ₹ per team, e.g. 3000. 0 = payer types the amount
  QR_IMAGE: "",                              // optional: "qr.png" to show your own QR image instead of the auto-generated one
  REQUIRE_SCREENSHOT: true,                  // make the payment screenshot compulsory

  EVENT_DATE: "20th December, 2026",
  VENUE: "Home Turf",
  CONTACTS: [                                // shown at the top and in the footer
    { name: "Leo Harshit Jain", role: "VP",  phone: "+91 93208 25103" },
    { name: "Leo Arham Jain",   role: "IPP", phone: "+91 77009 30888" }
  ],
  CLUBS: [                                   // suggestions in the club fields (people can still type any club)
    "Leo Club of Mumbai Western"
  ]
};
/* ===================================================================== */

const SIZES = ["XS","S","M","L","XL","XXL","3XL"];
const LOGO = document.querySelector(".crest img").src;
const REDUCED = matchMedia("(prefers-reduced-motion: reduce)").matches;
const DRAFT_KEY = "lcl5_draft_v1";
const $ = s => document.querySelector(s);
const $$ = s => Array.from(document.querySelectorAll(s));

/* ---------- build squad rows ---------- */
function sizeOptions(){ return '<option value="">Size</option>' + SIZES.map(s=>`<option>${s}</option>`).join(""); }
function rowHTML(slot, idx, gender, isSub){
  const gCell = isSub
    ? `<label class="f"><span>Gender</span><select data-k="gender"><option value="">Gender</option><option>Boy</option><option>Girl</option></select></label>`
    : "";
  const tag = isSub ? `<span class="gtag" style="background:#eee;color:#555">SUB</span>`
                    : `<span class="gtag ${gender==="Boy"?"boy":"girl"}">${gender==="Boy"?"B":"G"}</span>`;
  return `<div class="prow" data-slot="${slot}" data-gender="${gender||""}" data-sub="${isSub?1:0}">
    <div class="pidx"><span class="pnum">${idx}</span>${tag}<span class="pslot">${slot}</span><span class="cap">CAPTAIN</span></div>
    <label class="f fname"><span>Player name${isSub?"":" <em>*</em>"}</span><input data-k="name" maxlength="60" placeholder="${isSub?"Optional":"Full name"}" autocomplete="off"></label>
    ${gCell}
    <label class="f"><span>Size</span><select data-k="size">${sizeOptions()}</select></label>
    <label class="f"><span>Jersey no.</span><input data-k="number" type="text" inputmode="numeric" maxlength="3" placeholder="No."></label>
    <label class="f fclub"><span>Club</span><input data-k="club" list="clubList" maxlength="80" placeholder="Player's club"></label>
  </div>`;
}
(function build(){
  let h="";
  for(let i=1;i<=7;i++) h+=rowHTML("Boy "+i,i,"Boy",false);
  $("#boys").innerHTML=h; h="";
  for(let i=1;i<=2;i++) h+=rowHTML("Girl "+i,7+i,"Girl",false);
  $("#girls").innerHTML=h; h="";
  for(let i=1;i<=2;i++) h+=rowHTML("Substitute "+i,"S"+i,"",true);
  $("#subs").innerHTML=h;
  $("#clubList").innerHTML=CONFIG.CLUBS.map(c=>`<option value="${esc(c)}">`).join("");
  $("#factDate").textContent=CONFIG.EVENT_DATE; $("#factVenue").textContent=CONFIG.VENUE;
  $("#contacts").innerHTML='<p class="contacts-h">For further queries and information contact:</p>'+CONFIG.CONTACTS.map(c=>{ const d=c.phone.replace(/\D/g,""); return `<div class="contact"><div><b>${esc(c.name)}</b>${c.role?`, ${esc(c.role)}`:""}<span>${esc(c.phone)}</span></div><a class="cbtn" href="tel:+${d}" aria-label="Call ${esc(c.name)}">Call</a><a class="cbtn wa" href="https://wa.me/${d}" target="_blank" rel="noopener" aria-label="WhatsApp ${esc(c.name)}">WhatsApp</a></div>`; }).join("");
  $("#upiId").textContent=CONFIG.UPI_ID; $("#payeeName").textContent=CONFIG.UPI_PAYEE_NAME;
  const tk=["LCL 5.0","SEASON 5","7 BOYS + 2 GIRLS","2 SUBSTITUTES","REGISTER YOUR SQUAD","LEO CLUB OF MUMBAI WESTERN","HOWZAT!"].map(t=>`<span>${t}</span>`).join("");
  $("#tickerTrack").innerHTML=tk+tk;
  $("#amtText").innerHTML = CONFIG.ENTRY_FEE>0 ? `₹${Number(CONFIG.ENTRY_FEE).toLocaleString("en-IN")}<small>Total per team</small>` : `<small>₹5,000 registration<br>₹5,000 team owner</small>`;
  $("#ssReq").style.display = CONFIG.REQUIRE_SCREENSHOT ? "" : "none";
  const contacts = CONFIG.CONTACTS.filter(c=>c.name).map(c=>`<b>${esc(c.name)}</b>${c.role?`, ${esc(c.role)}`:""} · <a href="tel:+${c.phone.replace(/\D/g,"")}">${esc(c.phone)}</a>`).join("<br>");
  $("#footer").innerHTML = `<img class="foot-crest" src="${document.querySelector(".crest img").src}" alt="">Leo Cricket League 5.0 · Leo Club of Mumbai Western${contacts?`<br>Queries: ${contacts}`:""}`;
})();

function esc(s){ return String(s??"").replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c])); }
function toast(t){ const el=$("#toast"); el.textContent=t; el.classList.add("show"); clearTimeout(toast._t); toast._t=setTimeout(()=>el.classList.remove("show"),2200); }

/* ---------- UPI QR ---------- */
function upiLink(){
  const p = new URLSearchParams({ pa:CONFIG.UPI_ID, pn:CONFIG.UPI_PAYEE_NAME });
  if(CONFIG.UPI_AID) p.set("aid", CONFIG.UPI_AID);
  p.set("cu","INR"); p.set("tn","LCL 5.0 Registration");
  if(CONFIG.ENTRY_FEE>0) p.set("am", String(CONFIG.ENTRY_FEE));
  return "upi://pay?" + p.toString().replace(/\+/g,"%20").replace(/%40/g,"@");
}
function renderQR(){
  const box=$("#qr"); box.innerHTML="";
  if(CONFIG.QR_IMAGE){ box.innerHTML=`<img src="${esc(CONFIG.QR_IMAGE)}" alt="UPI QR code" width="220">`; }
  else if(window.QRCode){ new QRCode(box,{ text:upiLink(), width:220, height:220, colorDark:"#0c2b1c", colorLight:"#ffffff", correctLevel:QRCode.CorrectLevel.H }); box.insertAdjacentHTML("beforeend",`<img class="qr-logo" src="${LOGO}" alt="">`); }
  else if((renderQR.tries=(renderQR.tries||0)+1)<5){ box.innerHTML='<p style="color:#888;font-size:13px">QR is loading… you can also pay to the UPI ID.</p>'; setTimeout(renderQR,800); }
  else { box.innerHTML=`<img src="https://api.qrserver.com/v1/create-qr-code/?size=220x220&margin=0&data=${encodeURIComponent(upiLink())}" alt="UPI QR code" width="220" height="220">`; }
  $("#upiApp").href=upiLink();
}
window.addEventListener("load",renderQR);
$("#saveQr").onclick=()=>{
  const c=$("#qr canvas"), i=$("#qr img:not(.qr-logo)");
  let url=""; try{ if(c){ const o=document.createElement("canvas"); o.width=o.height=c.width+40; const x=o.getContext("2d"); x.fillStyle="#fff"; x.fillRect(0,0,o.width,o.height); x.drawImage(c,20,20); const L=$(".qr-logo"); if(L&&L.complete){ const w=c.width*.22; x.fillStyle="#fff"; x.fillRect((o.width-w)/2-3,(o.height-w)/2-3,w+6,w+6); x.drawImage(L,(o.width-w)/2,(o.height-w)/2,w,w*L.naturalHeight/L.naturalWidth); } url=o.toDataURL("image/png"); } else if(i) url=i.src; }catch(e){ url=i?i.src:""; }
  if(!url){ toast("Long-press the QR to save it"); return; }
  const a=document.createElement("a"); a.href=url; a.download="LCL5-payment-QR.png"; document.body.appendChild(a); a.click(); a.remove(); toast("QR saved. Scan it from your gallery in your UPI app");
};
$("#copyUpi").onclick=()=>{ navigator.clipboard?.writeText(CONFIG.UPI_ID).then(()=>toast("UPI ID copied"),()=>toast(CONFIG.UPI_ID)); };

/* ---------- squad helpers ---------- */
function rows(sel){ return $$(sel+" .prow"); }
function mainRows(){ return [...rows("#boys"),...rows("#girls")]; }
function val(row,k){ const el=row.querySelector(`[data-k="${k}"]`); return el?el.value.trim():""; }

function refreshCaptainOptions(){
  const sel=$("#captainSlot"), cur=sel.value;
  sel.innerHTML='<option value="">Select a player from the squad</option>' +
    mainRows().map(r=>{ const n=val(r,"name"); return n?`<option value="${r.dataset.slot}">${esc(n)} (${r.dataset.slot})</option>`:""; }).join("");
  if([...sel.options].some(o=>o.value===cur)) sel.value=cur;
  syncCaptain();
}
function syncCaptain(){
  const slot=$("#captainSlot").value;
  mainRows().forEach(r=>r.classList.toggle("is-cap", r.dataset.slot===slot));
  const r=mainRows().find(r=>r.dataset.slot===slot);
  $("#captainName").value = r ? val(r,"name") : "";
}
function countSquad(){
  const n=mainRows().filter(r=>val(r,"name")).length;
  const pill=$("#squadCount"); pill.textContent=`${n} / 9 players`; pill.classList.toggle("full",n===9);
}
$("#fillClub").onclick=()=>{
  const c=$("#clubName").value.trim(); if(!c){ toast("Enter the team's club name first"); $("#clubName").focus(); return; }
  $$('[data-k="club"]').forEach(i=>{ const row=i.closest(".prow"); if(row.dataset.sub==="1" && !val(row,"name")) return; i.value=c; });
  saveDraft(); revalidate(); progress(); toast("Club filled for all players");
};
$("#captainSlot").addEventListener("change",()=>{ syncCaptain(); saveDraft(); progress(); });

/* digits-only jersey numbers */
document.addEventListener("input",e=>{
  const t=e.target;
  if(t.matches('[data-k="number"]')) t.value=t.value.replace(/\D/g,"").slice(0,3);
  if(t.id==="captainPhone"||t.id==="altPhone") t.value=t.value.replace(/[^\d+]/g,"");
  if(t.classList.contains("err")) t.classList.remove("err");
  if(t.matches('[data-k="name"]')){ refreshCaptainOptions(); countSquad(); }
  debounceSave(); progress(); revalidate();
});
document.addEventListener("change",e=>{ if(e.target.classList.contains("err")) e.target.classList.remove("err"); debounceSave(); progress(); revalidate(); });

/* ---------- draft autosave ---------- */
let saveT; function debounceSave(){ clearTimeout(saveT); saveT=setTimeout(saveDraft,400); }
function collect(){
  const pr = r => ({ slot:r.dataset.slot, gender:r.dataset.sub==="1"?val(r,"gender"):r.dataset.gender, name:val(r,"name"), size:val(r,"size"), number:val(r,"number"), club:val(r,"club") });
  return {
    teamName:$("#teamName").value.trim(), ownerName:$("#ownerName").value.trim(), clubName:$("#clubName").value.trim(),
    players: mainRows().map(pr), subs: rows("#subs").map(pr),
    captainSlot:$("#captainSlot").value, captainName:$("#captainName").value.trim(),
    captainPhone:$("#captainPhone").value.trim(), captainEmail:$("#captainEmail").value.trim(), altPhone:$("#altPhone").value.trim(),
    payerName:$("#payerName").value.trim(), utr:$("#utr").value.trim().replace(/\s+/g,"")
  };
}
function saveDraft(){ try{ localStorage.setItem(DRAFT_KEY, JSON.stringify(collect())); }catch(e){} }
function loadDraft(){
  let d; try{ d=JSON.parse(localStorage.getItem(DRAFT_KEY)||"null"); }catch(e){ d=null; }
  if(!d) return;
  ["teamName","ownerName","clubName","captainPhone","captainEmail","altPhone","payerName","utr"].forEach(k=>{ if(d[k]!=null && $("#"+k)) $("#"+k).value=d[k]; });
  const fill=(list,arr)=>list.forEach((r,i)=>{ const p=(arr||[])[i]; if(!p) return; ["name","size","number","club","gender"].forEach(k=>{ const el=r.querySelector(`[data-k="${k}"]`); if(el && p[k]!=null) el.value=p[k]; }); });
  fill(mainRows(),d.players); fill(rows("#subs"),d.subs);
  refreshCaptainOptions(); if(d.captainSlot){ $("#captainSlot").value=d.captainSlot; syncCaptain(); }
  countSquad();
}

/* ---------- screenshot ---------- */
let screenshotData=null;
$("#screenshot").addEventListener("change",async e=>{
  const f=e.target.files[0]; screenshotData=null; const pv=$("#ssPreview"); pv.style.display="none";
  if(!f) return;
  if(!/^image\//.test(f.type)){ toast("Please choose an image file"); e.target.value=""; return; }
  try{ screenshotData=await compressImage(f,1280,0.72); pv.src="data:image/jpeg;base64,"+screenshotData; pv.style.display="block"; }
  catch(err){ toast("Couldn't read that image, try another"); e.target.value=""; }
  progress();
});
function compressImage(file,maxDim,q){
  return new Promise((res,rej)=>{
    const url=URL.createObjectURL(file), img=new Image();
    img.onload=()=>{ let {width:w,height:h}=img; const s=Math.min(1,maxDim/Math.max(w,h)); w=Math.round(w*s); h=Math.round(h*s);
      const c=document.createElement("canvas"); c.width=w; c.height=h; const x=c.getContext("2d"); x.fillStyle="#fff"; x.fillRect(0,0,w,h); x.drawImage(img,0,0,w,h);
      URL.revokeObjectURL(url); res(c.toDataURL("image/jpeg",q).split(",")[1]); };
    img.onerror=()=>{ URL.revokeObjectURL(url); rej(new Error("bad image")); };
    img.src=url;
  });
}

/* ---------- progress ---------- */
function progress(){
  const d=collect();
  const team = d.teamName&&d.ownerName&&d.clubName;
  const squad = d.players.every(p=>p.name&&p.size&&p.number&&p.club);
  const cap = d.captainSlot && /^\d{10}$/.test(normPhone(d.captainPhone)) && /\S+@\S+\.\S+/.test(d.captainEmail);
  const pay = d.payerName && d.utr && (!CONFIG.REQUIRE_SCREENSHOT || screenshotData) && $("#confirmBox").checked;
  const filled = [team,squad,cap,pay];
  ["team","squad","captain","pay"].forEach((k,i)=>$(`.steps a[data-step="${k}"]`).classList.toggle("done",!!filled[i]));
  // finer-grained percentage
  const fields=[d.teamName,d.ownerName,d.clubName,...d.players.flatMap(p=>[p.name,p.size,p.number,p.club]),d.captainSlot,d.captainPhone,d.captainEmail,d.payerName,d.utr,(CONFIG.REQUIRE_SCREENSHOT?screenshotData:"x"),$("#confirmBox").checked?"x":""];
  const pct=Math.round(fields.filter(Boolean).length/fields.length*100);
  $("#barFill").style.width=pct+"%"; $("#barText").textContent=pct+"%"; $("#barBall").style.left=pct+"%"; $("#barBall").style.transform=`rotate(${pct*7}deg)`;
}

/* ---------- validation ---------- */
function normPhone(p){ p=String(p||"").replace(/[^\d]/g,""); if(p.length===12&&p.startsWith("91")) p=p.slice(2); if(p.length===11&&p.startsWith("0")) p=p.slice(1); return p; }
function mark(el,msgs,m){ el.classList.add("err"); msgs.push(m); }
function showMsg(id,list){ const el=$("#"+id); if(list.length){ el.innerHTML=[...new Set(list)].map(esc).join("<br>"); el.classList.add("show"); } else { el.classList.remove("show"); el.innerHTML=""; } }

function validate(scroll=true){
  $$(".err").forEach(e=>e.classList.remove("err"));
  const mt=[],ms=[],mc=[],mp=[];
  ["teamName","ownerName","clubName"].forEach(id=>{ const el=$("#"+id); if(el.value.trim().length<2) mark(el,mt,"Please fill in the team name, owner name and club name."); });

  const nums={};
  const check=(r,required)=>{
    const name=val(r,"name"), any=name||val(r,"size")||val(r,"number")||(r.dataset.sub==="1"&&val(r,"gender"));
    if(!required && !any) return;
    const label=r.dataset.slot;
    const q=k=>r.querySelector(`[data-k="${k}"]`);
    if(name.length<2) mark(q("name"),ms,`${label}: player name is required.`);
    if(r.dataset.sub==="1" && !val(r,"gender")) mark(q("gender"),ms,`${label}: select Boy or Girl.`);
    if(!val(r,"size")) mark(q("size"),ms,`${label}: select a jersey size.`);
    const n=val(r,"number");
    if(n===""){ mark(q("number"),ms,`${label}: enter a jersey number.`); }
    else { const key=String(parseInt(n,10)); if(nums[key]){ mark(q("number"),ms,`Jersey number ${key} is used twice (${nums[key]} and ${label}).`); } else nums[key]=label; }
    if(!val(r,"club")) mark(q("club"),ms,`${label}: enter the player's club.`);
  };
  mainRows().forEach(r=>check(r,true));
  rows("#subs").forEach(r=>check(r,false));
  // duplicate names
  const seen={}; [...mainRows(),...rows("#subs")].forEach(r=>{ const n=val(r,"name").toLowerCase().replace(/\s+/g," "); if(!n) return; if(seen[n]) mark(r.querySelector('[data-k="name"]'),ms,`"${val(r,"name")}" is listed twice.`); seen[n]=1; });

  if(!$("#captainSlot").value) mark($("#captainSlot"),mc,"Select who the captain is.");
  if(!/^[6-9]\d{9}$/.test(normPhone($("#captainPhone").value))) mark($("#captainPhone"),mc,"Enter a valid 10-digit mobile number for the captain.");
  if(!/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test($("#captainEmail").value.trim())) mark($("#captainEmail"),mc,"Enter a valid email address for the captain.");
  const alt=$("#altPhone").value.trim(); if(alt && !/^[6-9]\d{9}$/.test(normPhone(alt))) mark($("#altPhone"),mc,"Alternate number should be a valid 10-digit mobile number.");

  if($("#payerName").value.trim().length<2) mark($("#payerName"),mp,"Enter the name of the person who paid.");
  const utr=$("#utr").value.replace(/\s+/g,"");
  if(!/^[A-Za-z0-9]{8,35}$/.test(utr)) mark($("#utr"),mp,"Enter the UPI transaction ID / UTR from your payment receipt.");
  if(CONFIG.REQUIRE_SCREENSHOT && !screenshotData) mark($("#screenshot"),mp,"Upload the payment screenshot.");
  if(!$("#confirmBox").checked) mp.push("Tick the confirmation box to submit.");

  showMsg("m-team",mt); showMsg("m-squad",ms); showMsg("m-captain",mc); showMsg("m-pay",mp);
  const first=$(".err")||$(".msg.show");
  if(first && scroll){ first.closest(".card").scrollIntoView({behavior:"smooth",block:"start"}); if(first.focus) setTimeout(()=>first.focus({preventScroll:true}),400); }
  return !(mt.length||ms.length||mc.length||mp.length);
}

/* ---------- submit with retry + idempotency ---------- */
function newKey(){ return (crypto.randomUUID?crypto.randomUUID():Date.now().toString(36)+Math.random().toString(36).slice(2)); }
let submissionKey=null, busy=false, tried=false;
let revT; function revalidate(){ if(!tried) return; clearTimeout(revT); revT=setTimeout(()=>validate(false),250); }

async function postOnce(payload){
  const ctrl=new AbortController(); const t=setTimeout(()=>ctrl.abort(),60000);
  try{
    const r=await fetch(CONFIG.SCRIPT_URL,{ method:"POST", body:JSON.stringify(payload), headers:{ "Content-Type":"text/plain;charset=utf-8" }, redirect:"follow", signal:ctrl.signal });
    const text=await r.text();
    try{ return JSON.parse(text); }catch(e){ return { ok:false, retry:true, error:"Unexpected server response." }; }
  } finally { clearTimeout(t); }
}

async function submit(){
  if(busy) return;
  tried=true;
  if(!validate()){ toast("Please fix the highlighted fields"); return; }
  if(!/^https:\/\/script\.google\.com\//.test(CONFIG.SCRIPT_URL)){ alert("The organisers haven't connected the Google Sheet yet (SCRIPT_URL is not set)."); return; }
  busy=true; const btn=$("#submitBtn"); btn.disabled=true; btn.classList.add("loading");
  if(!submissionKey) submissionKey=newKey();
  const d=collect();
  const payload={ ...d, captainPhone:normPhone(d.captainPhone), altPhone:d.altPhone?normPhone(d.altPhone):"",
    subs:d.subs.filter(s=>s.name), submissionKey, amount:CONFIG.ENTRY_FEE||"",
    screenshot: screenshotData?{ name:`${d.teamName}_payment.jpg`, data:screenshotData }:null,
    userAgent:navigator.userAgent.slice(0,200) };

  const waits=[0,2000,4000,8000,12000];
  let res=null, lastErr="";
  for(let i=0;i<waits.length;i++){
    if(waits[i]){ $("#btnText").textContent=`Busy, retrying (${i}/${waits.length-1})…`; await new Promise(r=>setTimeout(r,waits[i]+Math.random()*1000)); }
    else $("#btnText").textContent="Submitting…";
    try{ res=await postOnce(payload); }catch(e){ res=null; lastErr="Network problem. Check your internet connection."; }
    if(res && (res.ok || !res.retry)) break;
    if(res && res.error) lastErr=res.error;
  }
  busy=false; btn.disabled=false; btn.classList.remove("loading"); $("#btnText").textContent="Submit registration";

  if(res && res.ok){ showSuccess(res,d); return; }
  const msg=(res&&res.error)||lastErr||"Something went wrong. Please try again.";
  showMsg("m-pay",[msg]); $("#s-pay").scrollIntoView({behavior:"smooth"}); toast(msg);
}
$("#submitBtn").addEventListener("click",submit);
$("#confirmBox").addEventListener("change",()=>{ progress(); revalidate(); });

function showSuccess(res,d){
  try{ localStorage.removeItem(DRAFT_KEY); }catch(e){}
  $("#sTeam").textContent=d.teamName; $("#sId").textContent=res.registrationId;
  const fmt=p=>`${esc(p.name)}, ${esc(p.size)}, ${esc(p.number)}${p.club?` <span style="color:#888">· ${esc(p.club)}</span>`:""}`;
  const rowsHtml=[
    ["Team owner",esc(d.ownerName)],["Club",esc(d.clubName)],
    ["Captain",`${esc(d.captainName)} · ${esc(normPhone(d.captainPhone))}`],
    ...d.players.map(p=>[p.slot+(p.slot===d.captainSlot?" (C)":""),fmt(p)]),
    ...d.subs.filter(s=>s.name).map(p=>[p.slot+` (${esc(p.gender)})`,fmt(p)]),
    ["UTR",esc(d.utr)],["Status","Payment pending verification"]
  ].map(([a,b])=>`<tr><td>${a}</td><td>${b}</td></tr>`).join("");
  $("#sTable").innerHTML=rowsHtml;
  $("#formWrap").style.display="none"; $(".progress").style.display="none"; $("#submitBar").style.display="none";
  $("#success").style.display="block"; celebrate(); window.scrollTo({top:$("#success").offsetTop-10,behavior:"smooth"});
}
$("#another").onclick=()=>{ location.reload(); };

/* ---------- live status (open / closed / slots) ---------- */
async function checkStatus(){
  if(!/^https:\/\/script\.google\.com\//.test(CONFIG.SCRIPT_URL)) return;
  try{
    const r=await fetch(CONFIG.SCRIPT_URL+"?action=status",{redirect:"follow"}); const s=await r.json();
    const b=$("#statusBanner");
    if(!s.open){ b.className="status-banner show closed"; b.textContent=s.message||"Registrations are closed."; $("#submitBtn").disabled=true; $("#btnText").textContent="Registrations closed"; }
    else if(s.max>0){ const left=Math.max(0,s.max-s.count); b.className="status-banner show "+(left?"open":"closed"); b.textContent= left?`Registrations are open · ${left} of ${s.max} team slots left`:"All team slots are filled."; if(!left){ $("#submitBtn").disabled=true; $("#btnText").textContent="Slots full"; } }
    else { b.className="status-banner show open"; b.textContent="Registrations are open"; }
  }catch(e){ /* status is optional; the form still works */ }
}


/* ---------- hero animation: bowled ball + floodlight dust ---------- */
(function heroFx(){
  const cv=$("#heroFx"), hero=document.querySelector(".hero"), ctx=cv.getContext("2d"), stumps=$("#stumps");
  let W=0,H=0,dpr=1, dust=[], run=true, t0=performance.now(), trail=[], hit=false;
  function size(){ dpr=Math.min(2,window.devicePixelRatio||1); W=hero.clientWidth; H=hero.clientHeight; cv.width=W*dpr; cv.height=H*dpr; ctx.setTransform(dpr,0,0,dpr,0,0);
    dust=Array.from({length:Math.round(W/22)},()=>({x:Math.random()*W,y:Math.random()*H,r:Math.random()*1.6+.4,v:Math.random()*.25+.08,a:Math.random()*.5+.2})); }
  size(); addEventListener("resize",size);
  const CYCLE=4800;
  function ballPos(p){ // p 0..1 : release (right, high) -> bounce on pitch -> stumps (left)
    const sx=W*1.05, ex=stumpsX(), groundY=H-22, bx=ex+(sx-ex)*0.32;
    const x=sx+(ex-sx)*p, bounceP=(sx-bx)/(sx-ex);
    let y; if(p<bounceP){ const q=p/bounceP; y=H*0.40+(groundY-H*0.40)*q*q; }
    else { const q=(p-bounceP)/(1-bounceP); y=groundY-Math.sin(q*Math.PI*0.55)*(H*0.12)*(1-q*0.2)-q*48; }
    return {x,y};
  }
  function stumpsX(){ const r=stumps.getBoundingClientRect(), h=hero.getBoundingClientRect(); return r.left-h.left+r.width/2; }
  function drawBall(x,y,rot,r){
    ctx.save(); ctx.translate(x,y); ctx.rotate(rot);
    const g=ctx.createRadialGradient(-r*.35,-r*.35,r*.1,0,0,r); g.addColorStop(0,"#ef5a62"); g.addColorStop(.55,"#b3151d"); g.addColorStop(1,"#5e0a0f");
    ctx.fillStyle=g; ctx.beginPath(); ctx.arc(0,0,r,0,Math.PI*2); ctx.fill();
    ctx.strokeStyle="#f3e6c9"; ctx.lineWidth=1.4; ctx.beginPath(); ctx.moveTo(-r*.25,-r*.95); ctx.quadraticCurveTo(r*.25,0,-r*.25,r*.95); ctx.stroke();
    ctx.beginPath(); ctx.moveTo(r*.1,-r*.95); ctx.quadraticCurveTo(r*.6,0,r*.1,r*.95); ctx.stroke(); ctx.restore();
  }
  function frame(now){
    if(!run) return;
    ctx.clearRect(0,0,W,H);
    for(const d of dust){ d.y-=d.v; d.x+=Math.sin((now/1000)+d.y*.02)*.15; if(d.y<-4){ d.y=H+4; d.x=Math.random()*W; }
      ctx.fillStyle=`rgba(255,236,180,${d.a})`; ctx.beginPath(); ctx.arc(d.x,d.y,d.r,0,Math.PI*2); ctx.fill(); }
    const p=((now-t0)%CYCLE)/CYCLE, travel=0.62;
    if(p<travel){
      const q=p/travel, pos=ballPos(q); trail.push(pos); if(trail.length>14) trail.shift();
      trail.forEach((tp,i)=>{ ctx.fillStyle=`rgba(242,182,50,${i/trail.length*.28})`; ctx.beginPath(); ctx.arc(tp.x,tp.y,3+i*.45,0,Math.PI*2); ctx.fill(); });
      drawBall(pos.x,pos.y,-now/60,W<600?8:10); hit=false;
    } else { trail.length=0; if(!hit){ hit=true; stumps.classList.remove("bowled"); void stumps.getBoundingClientRect(); stumps.classList.add("bowled"); setTimeout(()=>stumps.classList.remove("bowled"),1500); } }
    requestAnimationFrame(frame);
  }
  if(REDUCED){ for(const d of dust){ ctx.fillStyle=`rgba(255,236,180,${d.a})`; ctx.beginPath(); ctx.arc(d.x,d.y,d.r,0,Math.PI*2); ctx.fill(); } return; }
  new IntersectionObserver(es=>{ const vis=es[0].isIntersecting; if(vis&&!run){ run=true; requestAnimationFrame(frame);} else if(!vis) run=false; }).observe(hero);
  requestAnimationFrame(frame);
})();

/* ---------- success confetti ---------- */
function celebrate(){
  if(REDUCED) return;
  const cv=$("#confetti"), ctx=cv.getContext("2d"), dpr=Math.min(2,devicePixelRatio||1);
  cv.width=innerWidth*dpr; cv.height=innerHeight*dpr; ctx.setTransform(dpr,0,0,dpr,0,0);
  const cols=["#f2b632","#ffd36b","#1f7a45","#ffffff","#b3151d","#24508f"];
  const ps=Array.from({length:170},()=>({x:innerWidth/2,y:innerHeight*.35,vx:(Math.random()-.5)*14,vy:Math.random()*-13-4,w:Math.random()*8+4,h:Math.random()*5+3,r:Math.random()*6,vr:(Math.random()-.5)*.3,c:cols[Math.random()*cols.length|0]}));
  const start=performance.now();
  (function f(now){ const el=now-start; ctx.clearRect(0,0,innerWidth,innerHeight);
    ps.forEach(p=>{ p.vy+=.35; p.vx*=.99; p.x+=p.vx; p.y+=p.vy; p.r+=p.vr; ctx.save(); ctx.translate(p.x,p.y); ctx.rotate(p.r); ctx.globalAlpha=Math.max(0,1-el/3200); ctx.fillStyle=p.c; ctx.fillRect(-p.w/2,-p.h/2,p.w,p.h); ctx.restore(); });
    if(el<3300) requestAnimationFrame(f); else ctx.clearRect(0,0,innerWidth,innerHeight); })(start);
}

loadDraft(); countSquad(); progress(); checkStatus();
